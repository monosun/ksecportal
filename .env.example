DB_ROOT_PASSWORD=rootpassword
DB_USER=secportal
# MySQL 컨테이너 초기화에 쓰이는 평문 비밀번호 (DB 컨테이너는 평문만 인식합니다)
DB_PASSWORD=secportal123
# 백엔드가 사용할 DB 비밀번호 — 관리 > 설정관리 > 보안 설정의 "설정값 암호화"로 만든 ENC(...) 값을 넣으세요.
# 값이 있으면 DB_PASSWORD 대신 이 값이 백엔드에 주입되고, 기동 시 마스터 키로 복호화됩니다.
DB_PASSWORD_ENC=
JWT_SECRET=your-256-bit-secret-key-change-in-production-must-be-32-chars-min
# JWT 시크릿도 ENC(...) 로 넣을 수 있습니다 (지정 시 JWT_SECRET 보다 우선)
JWT_SECRET_ENC=
JWT_EXPIRATION=86400000

# Jasypt 마스터 키 — 모든 ENC(...) 값을 복호화하는 키입니다. 반드시 변경하고 16자 이상으로 두세요.
JASYPT_ENCRYPTOR_PASSWORD=your-master-key
# 마스터 키를 파일로 주입하면 docker inspect·프로세스 환경에 평문이 노출되지 않습니다 (권장).
# 예) JASYPT_ENCRYPTOR_PASSWORD_FILE=/run/secrets/jasypt_key  (backend 컨테이너에 파일 마운트 필요)
JASYPT_ENCRYPTOR_PASSWORD_FILE=

# true 로 두면 기본값·평문 비밀이 남아 있을 때 백엔드 기동을 중단합니다 (운영 권장)
SECURITY_FAIL_ON_INSECURE_SECRETS=false

# ── 개인정보 컬럼 암호화 (v1.28.0) ────────────────────────────────────────────
# 정보주체 권리행사(정보주체명·연락처)와 수탁사 담당자 정보(사업자등록번호·담당자·이메일·연락처)를
# AES-256-GCM 으로 암호화해 저장합니다.
# 비워 두면 위 Jasypt 마스터 키를 사용합니다. 별도 키를 쓰면 마스터 키가 바뀌어도 개인정보는 계속 복호화됩니다.
# !! 이 키를 잃으면 암호화된 개인정보는 복구할 수 없습니다. 백업본과 분리해 보관하세요.
PI_ENCRYPTION_KEY=
# 키를 파일로 주입하려면 (권장) — 예) /run/secrets/pi_key
PI_ENCRYPTION_KEY_FILE=
# false 로 두면 평문으로 저장됩니다 (권장하지 않음)
PI_COLUMN_ENCRYPTION_ENABLED=true

# CORS — 프론트엔드 오리진 목록 (쉼표 구분)
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:80

# Email (optional — scheduler skips send when MAIL_PASSWORD is empty)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=noreply@example.com
MAIL_PASSWORD=
# 메일 비밀번호도 ENC(...) 로 넣을 수 있습니다 (지정 시 MAIL_PASSWORD 보다 우선)
MAIL_PASSWORD_ENC=

# 서버 URL (승인 이메일 내 링크에 사용)
APP_BASE_URL=https://your-domain.com/api
